@model IReadOnlyList<AracGorevVeYakitTakipSistemi.Application.DTOs.GorevDto>
@{
    ViewData["Title"] = "Görevler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-clipboard-check me-2"></i>Görev Listesi</h1>
    <a asp-action="Yeni" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Yeni Görev Oluştur
    </a>
</div>

@if (TempData["Basari"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>@TempData["Basari"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>@TempData["Hata"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-clipboard fs-1 d-block mb-2"></i>
        <p>Henüz görev kaydı yok. <a asp-action="Yeni">İlk görevi oluşturun.</a></p>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 datatable-auto">
                    <thead class="table-light">
                        <tr>
                            <th>Tarih</th>
                            <th>Araç</th>
                            <th>Sürücü</th>
                            <th>Gidilecek Yer</th>
                            <th>Mesafe</th>
                            <th>Durum</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var g in Model)
                        {
                            <tr>
                                <td>@g.GorevTarihi.ToString("dd.MM.yyyy")</td>
                                <td><strong>@g.AracPlaka</strong></td>
                                <td>@g.SurucuAdSoyad</td>
                                <td>@g.GidilecekYer</td>
                                <td>
                                    @if (g.ToplamMesafe.HasValue)
                                    {
                                        <span>@g.ToplamMesafe.Value.ToString("N0") km</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @{
                                        var (durumBadge, durumMetin) = g.Durum.ToString() switch
                                        {
                                            "Planlandi" => ("badge bg-info text-dark", "Planlandı"),
                                            "DevamEdiyor" => ("badge bg-warning text-dark", "Devam Ediyor"),
                                            "Tamamlandi" => ("badge bg-success", "Tamamlandı"),
                                            _ => ("badge bg-secondary", "İptal")
                                        };
                                    }
                                    <span class="@durumBadge">@durumMetin</span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Detay" asp-route-id="@g.GorevId"
                                       class="btn btn-sm btn-outline-secondary me-1" title="Detay">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Sil" asp-route-id="@g.GorevId"
                                       class="btn btn-sm btn-outline-danger btn-sil-onayla" title="Sil"
                                       data-isim="@g.GorevTarihi.ToString("dd.MM.yyyy") – @g.AracPlaka / @g.SurucuAdSoyad görevi">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
