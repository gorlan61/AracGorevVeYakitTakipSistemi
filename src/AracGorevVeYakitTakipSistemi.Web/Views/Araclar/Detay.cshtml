@model AracGorevVeYakitTakipSistemi.Application.DTOs.AracDto
@{
    ViewData["Title"] = "Araç Detayı";
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h1 class="h3 mb-0">Araç Detayı — @Model.Plaka</h1>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm mb-3">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-info-circle me-1"></i>Araç Bilgileri</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Plaka</dt>
                    <dd class="col-sm-8"><strong>@Model.Plaka</strong></dd>

                    <dt class="col-sm-4">Marka / Model</dt>
                    <dd class="col-sm-8">@Model.Marka @Model.Model</dd>

                    <dt class="col-sm-4">Model Yılı</dt>
                    <dd class="col-sm-8">@Model.ModelYili</dd>

                    <dt class="col-sm-4">Yakıt Türü</dt>
                    <dd class="col-sm-8">@Model.YakitTuru</dd>

                    <dt class="col-sm-4">Ruhsat No</dt>
                    <dd class="col-sm-8">@Model.RuhsatNo</dd>

                    <dt class="col-sm-4">Güncel Km</dt>
                    <dd class="col-sm-8">@Model.GuncelKm.ToString("N0") km</dd>

                    <dt class="col-sm-4">Durum</dt>
                    <dd class="col-sm-8">
                        @{
                            var badge = Model.Durum.ToString() switch
                            {
                                "Aktif" => "badge bg-success",
                                "Bakimda" => "badge bg-warning text-dark",
                                _ => "badge bg-secondary"
                            };
                            var durumMetin = Model.Durum.ToString() switch
                            {
                                "Aktif" => "Aktif",
                                "Bakimda" => "Bakımda",
                                _ => "Pasif"
                            };
                        }
                        <span class="@badge">@durumMetin</span>
                    </dd>

                    <dt class="col-sm-4">Kayıt Tarihi</dt>
                    <dd class="col-sm-8">@Model.KayitTarihi.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>
                </dl>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Duzenle" asp-route-id="@Model.AracId" class="btn btn-primary">
                <i class="bi bi-pencil me-1"></i>Düzenle
            </a>
            <a asp-action="Sil" asp-route-id="@Model.AracId" class="btn btn-outline-danger">
                <i class="bi bi-trash me-1"></i>Sil
            </a>
        </div>
    </div>
</div>
