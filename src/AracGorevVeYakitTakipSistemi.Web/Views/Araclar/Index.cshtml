@model IReadOnlyList<AracGorevVeYakitTakipSistemi.Application.DTOs.AracDto>
@{
    ViewData["Title"] = "Araçlar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-truck me-2"></i>Araç Listesi</h1>
    <a asp-action="Yeni" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Yeni Araç Ekle
    </a>
</div>

@if (TempData["Basari"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>@TempData["Basari"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>@TempData["Hata"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-truck fs-1 d-block mb-2"></i>
        <p>Henüz kayıtlı araç yok. <a asp-action="Yeni">İlk aracı ekleyin.</a></p>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 datatable-auto">
                    <thead class="table-light">
                        <tr>
                            <th>Plaka</th>
                            <th>Marka / Model</th>
                            <th>Yıl</th>
                            <th>Yakıt</th>
                            <th>Güncel Km</th>
                            <th>Durum</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var arac in Model)
                        {
                            <tr>
                                <td><strong>@arac.Plaka</strong></td>
                                <td>@arac.Marka @arac.Model</td>
                                <td>@arac.ModelYili</td>
                                <td>@arac.YakitTuru</td>
                                <td>@arac.GuncelKm.ToString("N0") km</td>
                                <td>
                                    @{
                                        var badge = arac.Durum.ToString() switch
                                        {
                                            "Aktif" => "badge bg-success",
                                            "Bakimda" => "badge bg-warning text-dark",
                                            _ => "badge bg-secondary"
                                        };
                                        var durumMetin = arac.Durum.ToString() switch
                                        {
                                            "Aktif" => "Aktif",
                                            "Bakimda" => "Bakımda",
                                            _ => "Pasif"
                                        };
                                    }
                                    <span class="@badge">@durumMetin</span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Detay" asp-route-id="@arac.AracId"
                                       class="btn btn-sm btn-outline-secondary me-1" title="Detay">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Duzenle" asp-route-id="@arac.AracId"
                                       class="btn btn-sm btn-outline-primary me-1" title="Düzenle">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Sil" asp-route-id="@arac.AracId"
                                       class="btn btn-sm btn-outline-danger btn-sil-onayla" title="Sil"
                                       data-isim="@arac.Plaka – @arac.Marka @arac.Model">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
