@model AracGorevVeYakitTakipSistemi.Application.DTOs.SurucuDto
@{
    ViewData["Title"] = "Sürücü Detayı";
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h1 class="h3 mb-0">Sürücü Detayı — @Model.AdSoyad</h1>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="card shadow-sm mb-3">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-person-badge me-1"></i>Sürücü Bilgileri</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Ad Soyad</dt>
                    <dd class="col-sm-8"><strong>@Model.AdSoyad</strong></dd>

                    <dt class="col-sm-4">Ehliyet Sınıfı</dt>
                    <dd class="col-sm-8">@Model.EhliyetSinifi</dd>

                    <dt class="col-sm-4">Telefon</dt>
                    <dd class="col-sm-8">@Model.Telefon</dd>

                    <dt class="col-sm-4">E-posta</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Durum</dt>
                    <dd class="col-sm-8">
                        <span class="badge @(Model.AktifMi ? "bg-success" : "bg-secondary")">
                            @(Model.AktifMi ? "Aktif" : "Pasif")
                        </span>
                    </dd>

                    <dt class="col-sm-4">Kayıt Tarihi</dt>
                    <dd class="col-sm-8">@Model.KayitTarihi.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>
                </dl>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Duzenle" asp-route-id="@Model.SurucuId" class="btn btn-primary">
                <i class="bi bi-pencil me-1"></i>Düzenle
            </a>
            <a asp-action="Sil" asp-route-id="@Model.SurucuId" class="btn btn-outline-danger">
                <i class="bi bi-trash me-1"></i>Sil
            </a>
        </div>
    </div>
</div>
