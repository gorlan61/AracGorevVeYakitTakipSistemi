@model IReadOnlyList<AracGorevVeYakitTakipSistemi.Application.DTOs.SurucuDto>
@{
    ViewData["Title"] = "Sürücüler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-person-badge me-2"></i>Sürücü Listesi</h1>
    <a asp-action="Yeni" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Yeni Sürücü Ekle
    </a>
</div>

@if (TempData["Basari"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>@TempData["Basari"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>@TempData["Hata"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-person-badge fs-1 d-block mb-2"></i>
        <p>Henüz kayıtlı sürücü yok. <a asp-action="Yeni">İlk sürücüyü ekleyin.</a></p>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 datatable-auto">
                    <thead class="table-light">
                        <tr>
                            <th>Ad Soyad</th>
                            <th>Ehliyet Sınıfı</th>
                            <th>Telefon</th>
                            <th>E-posta</th>
                            <th>Durum</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var surucu in Model)
                        {
                            <tr>
                                <td><strong>@surucu.AdSoyad</strong></td>
                                <td>@surucu.EhliyetSinifi</td>
                                <td>@surucu.Telefon</td>
                                <td>@surucu.Email</td>
                                <td>
                                    <span class="badge @(surucu.AktifMi ? "bg-success" : "bg-secondary")">
                                        @(surucu.AktifMi ? "Aktif" : "Pasif")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Detay" asp-route-id="@surucu.SurucuId"
                                       class="btn btn-sm btn-outline-secondary me-1" title="Detay">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Duzenle" asp-route-id="@surucu.SurucuId"
                                       class="btn btn-sm btn-outline-primary me-1" title="Düzenle">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Sil" asp-route-id="@surucu.SurucuId"
                                       class="btn btn-sm btn-outline-danger btn-sil-onayla" title="Sil"
                                       data-isim="@surucu.AdSoyad">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
