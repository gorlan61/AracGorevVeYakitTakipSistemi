@model AracGorevVeYakitTakipSistemi.Application.DTOs.SurucuDto
@{
    bool yeniKayit = Model.SurucuId == 0;
    ViewData["Title"] = yeniKayit ? "Yeni Sürücü Ekle" : "Sürücü Düzenle";
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h1 class="h3 mb-0">@ViewData["Title"]</h1>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="@(yeniKayit ? "Yeni" : "Duzenle")" asp-route-id="@Model.SurucuId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="SurucuId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="AdSoyad" class="form-label fw-semibold">Ad Soyad <span class="text-danger">*</span></label>
                            <input asp-for="AdSoyad" class="form-control" placeholder="Tam adı girin" />
                            <span asp-validation-for="AdSoyad" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="EhliyetSinifi" class="form-label fw-semibold">Ehliyet Sınıfı <span class="text-danger">*</span></label>
                            <input asp-for="EhliyetSinifi" class="form-control" placeholder="Örn: B, C, D" />
                            <span asp-validation-for="EhliyetSinifi" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Telefon" class="form-label fw-semibold">Telefon <span class="text-danger">*</span></label>
                            <input asp-for="Telefon" class="form-control" placeholder="05xx xxx xx xx" type="tel" />
                            <span asp-validation-for="Telefon" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold">E-posta <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control" placeholder="ornek@mail.com" type="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input asp-for="AktifMi" class="form-check-input" role="switch" id="AktifMiSwitch" />
                                <label class="form-check-label" for="AktifMiSwitch">Aktif sürücü</label>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-floppy me-1"></i>@(yeniKayit ? "Kaydet" : "Güncelle")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
