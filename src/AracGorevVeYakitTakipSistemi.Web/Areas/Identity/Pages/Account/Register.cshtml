@page
@model AracGorevVeYakitTakipSistemi.Web.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">Kayıt Ol</h1>
                <p class="text-muted">Yeni bir operatör hesabı oluşturun.</p>
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.KullaniciAdi" class="form-control" autocomplete="username" placeholder="Kullanıcı adı" />
                        <label asp-for="Input.KullaniciAdi">Kullanıcı adı</label>
                        <span asp-validation-for="Input.KullaniciAdi" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="E-posta" />
                        <label asp-for="Input.Email">E-posta</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Sifre" class="form-control" autocomplete="new-password" placeholder="Şifre" />
                        <label asp-for="Input.Sifre">Şifre</label>
                        <span asp-validation-for="Input.Sifre" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.SifreTekrar" class="form-control" autocomplete="new-password" placeholder="Şifre tekrarı" />
                        <label asp-for="Input.SifreTekrar">Şifre tekrarı</label>
                        <span asp-validation-for="Input.SifreTekrar" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Kayıt Ol</button>
                </form>
                <p class="mt-3 mb-0 text-center">Zaten hesabınız var mı? <a asp-page="./Login">Giriş yap</a></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
